---
type Props = {
    class?: string;
};

const { class: customClass } = Astro.props;
---

<div
    class="w-full prose prose:text-red-100 dark:prose-headings:text-zag-light prose-p:text-zag-dark prose-p:dark:text-zag-light dark:prose-invert prose-a:underline-offset-4 prose-strong:text-zag-dark dark:prose-strong:text-zag-light prose-li:text-zag-dark dark:prose-li:text-zag-light prose-ul:marker:text-zag-dark prose-ul:dark:marker:text-zag-light prose-ol:marker:text-zag-dark prose-ol:dark:marker:text-zag-light prose-a:text-zag-dark prose-a:dark:text-zag-light prose-code:after:text-red-100 prose-code:before:text-red-100 prose-code:p-1 prose-code:bg-amber-900/10 prose-code:dark:bg-amber-900/30 prose-code:dark:text-amber-500 prose-pre:dark:*:bg-transparent"
    class:list={customClass ? [customClass] : []}
>
    <slot />
</div>
