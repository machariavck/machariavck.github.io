---
type Props = {
  class?: string;
};

const { class: customClass } = Astro.props;
---

<div
  class="w-full prose prose:text-red-100 dark:prose-headings:text-zag-light prose-img:border prose-p:text-zag-dark prose-p:dark:text-zag-light dark:prose-invert prose-a:underline-offset-4 prose-strong:text-zag-dark dark:prose-strong:text-zag-light prose-li:text-zag-dark dark:prose-li:text-zag-light prose-ul:marker:text-zag-dark prose-ul:dark:marker:text-zag-light prose-ol:marker:text-zag-dark prose-ol:dark:marker:text-zag-light prose-a:text-zag-dark prose-a:dark:text-zag-light prose-code:after:text-red-100 prose-code:before:text-red-100 prose-code:outline prose-code:p-1 prose-code:outline-amber-200 prose-code:dark:outline-amber-900 prose-code:dark:text-zag-light prose-pre:*:outline-none prose-pre:outline prose-pre:outline-zag-light"
  class:list={customClass ? [customClass] : []}
>
  <slot />
</div>
