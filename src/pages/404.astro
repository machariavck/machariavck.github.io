---
import Section from "../components/common/Section.astro";
import Layout from "../layouts/Layout.astro";
import { getConfigurationCollection } from "../lib/utils";

const { data: config } = await getConfigurationCollection();
---

<Layout>
    <Fragment slot="head">
        <title>{config.notFoundMeta.title}</title>
        <meta name="description" content={config.notFoundMeta.description}/>
        <meta property="og:title" content={config.notFoundMeta.title}/>
        <meta property="og:description" content={config.notFoundMeta.description}/>
        <meta property="og:url" content={config.site.baseUrl} />
        <meta name="x:card" content="summary_large_image" />
        <meta name="x:title" content={config.notFoundMeta.title} />
        <meta name="x:description" content={config.notFoundMeta.description} />
        <meta http-equiv="content-language" content="en" />
        <meta name="language" content="English" />
        <link rel="canonical" href={config.site.baseUrl} />
    </Fragment>
    <Section class="mt-16">
        <h1 class="text-3xl sm:text-4xl font-display pb-8">
            Uhm, I don't exist, lol..
        </h1>
    </Section>
</Layout>
