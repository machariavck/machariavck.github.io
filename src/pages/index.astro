---
import Layout from "../layouts/Layout.astro";
import Section from "../components/common/Section.astro";
import FeaturedArticles from "../components/home/FeaturedArticles.astro";
import { getConfigurationCollection } from "../lib/utils";
import { getCollection } from "astro:content";

const { data: config } = await getConfigurationCollection();

const featuredArticles = (
    await getCollection("blog", (e) => e.data.featured)
).map((e) => ({
    ...e.data,
    url: `/blog/${e.data.slug}`,
}));
---

<Layout>
    <Fragment slot="head">
        <title>{config.globalMeta.title}</title>
        <meta name="description" content={config.globalMeta.description}/>
        <meta property="og:title" content={config.globalMeta.title}/>
        <meta property="og:description" content={config.globalMeta.description}/>
        {
            config.globalMeta.keywords && (
                <meta
                    name="keywords"
                    content={config.globalMeta.keywords.join(", ")}
                />
            )
        }
        <meta property="og:url" content={config.site.baseUrl} />
        <meta name="x:card" content="summary_large_image" />
        <meta name="x:title" content={config.globalMeta.title} />
        <meta name="x:description" content={config.globalMeta.description} />
        <meta http-equiv="content-language" content="en" />
        <meta name="language" content="English" />
        <link rel="canonical" href={config.site.baseUrl} />
    </Fragment>
    <Section class="my-16 text-center font-display">
        _ Hello, welcome to my blog ;) _
    </Section>
    <Section>
        <FeaturedArticles featuredArticles={featuredArticles} />
    </Section>
</Layout>
